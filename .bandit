# Bandit configuration, auto-discovered when bandit runs from the repository
# root. INI format; bandit's -c flag expects YAML instead, so this file is
# found rather than passed.
#
# Untuned, bandit reports 413 findings here and 378 are assert_used in the
# test suites. Asserts are how those tests work, so that is not a finding, it
# is the tool not knowing which files are tests. A channel carrying 400
# known-irrelevant messages is a channel nobody reads.
#
# Every skip below was checked against the actual finding rather than assumed.
#
# B101 assert_used. The six suites are assert-driven by design. The check
#   targets asserts left in production code, where python -O strips them.
#   Nothing here ships.
# B311 random. resource_mdp seeds random.Random deliberately so a graph
#   rebuilds identically. Determinism is the requirement. No cryptographic
#   use anywhere in the tree.
# B404, B603, B607 subprocess. Two call sites, both running git with a fixed
#   argument list and shell=False, to record git_head in an artifact.
#
# Deliberately NOT skipped, so they stay visible:
# B310 urlopen, eight call sites building URLs from --azure-endpoint and
#   --base-url. Benign while the user is the operator, but this is where it
#   would matter if that ever became untrusted input.
# B112 try_except_continue and B104, low count, worth reading each time.

[bandit]
exclude = ./archive,./.git,./experiments/exploratory
skips = B101,B311,B404,B603,B607
